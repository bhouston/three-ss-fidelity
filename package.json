{
  "name": "three-ss-fidelity",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-space effect fidelity suite: three.js SSGI/SSR/SSAO vs three-gpu-pathtracer ground truth.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -b && pnpm build:three && pnpm -r --if-present --filter './packages/*' build",
    "dev": "pnpm -r --parallel --stream dev",
    "tsc": "tsc -b && pnpm --filter @ss-fidelity/playground tsc",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "pnpm --filter @ss-fidelity/cli start",
    "fidelity:dev": "fidelity-kit dev results",
    "fidelity:build": "fidelity-kit build results --out site/",
    "live": "pnpm --filter @ss-fidelity/playground dev",
    "build:three": "pnpm --filter ./submodules/three.js build",
    "test:browser": "pnpm --filter @ss-fidelity/playground test:browser"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "draco3dgltf": "^1.5.7",
    "fidelity-kit": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "watlas": "^1.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
