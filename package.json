{
  "name": "three-ss-fidelity",
  "version": "0.1.0",
  "private": true,
  "description": "Screen-space effect fidelity suite: three.js SSGI/SSR/SSAO vs three-gpu-pathtracer ground truth.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm build:fidelity-kit && tsc -b && pnpm build:three && pnpm -r --if-present --filter \"@ss-fidelity/*\" build",
    "dev": "pnpm -r --parallel --stream dev",
    "tsc": "tsc -b && pnpm --filter @ss-fidelity/playground tsc",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "pnpm --filter @ss-fidelity/cli start",
    "fidelity:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "fidelity:build": "fidelity-kit build fidelity-results --performance-root performance-results --registry registry.json --out site/",
    "live": "pnpm --filter @ss-fidelity/playground dev --open /performance.html",
    "build:three": "pnpm --filter ./submodules/three.js build",
    "test:browser": "pnpm --filter @ss-fidelity/playground test:browser",
    "performance:run": "fidelity-kit benchmark ${PERFORMANCE_MACHINE:+--machine \"$PERFORMANCE_MACHINE\"} --registry registry.json --collection default --out performance-results",
    "performance:serve": "fidelity-kit serve fidelity-results --performance-root performance-results --registry registry.json",
    "performance:build": "fidelity-kit build fidelity-results --performance-root performance-results --registry registry.json --out site/",
    "performance:metallic": "fidelity-kit benchmark ${PERFORMANCE_MACHINE:+--machine \"$PERFORMANCE_MACHINE\"} --registry registry.json --collection metallic --out performance-results --renderer-root packages/playground/dist",
    "performance:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "performance:process": "fidelity-kit process fidelity-results --performance-root performance-results",
    "performance:convergence": "fidelity-kit benchmark ${PERFORMANCE_MACHINE:+--machine \"$PERFORMANCE_MACHINE\"} --registry registry.json --collection convergence --out performance-results --renderer-root packages/playground/dist",
    "build:fidelity-kit": "tsc -b submodules/fidelity-kit/packages/cli && pnpm --filter @fidelity-kit/viewer build",
    "site:dev": "fidelity-kit dev fidelity-results --performance-root performance-results --registry registry.json",
    "site:build": "fidelity-kit build fidelity-results --performance-root performance-results --registry registry.json --out site/",
    "render": "fidelity-kit render --registry registry.json --out fidelity-results",
    "test:unified": "node scripts/unified-site-smoke.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "draco3dgltf": "^1.5.7",
    "fidelity-kit": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "watlas": "^1.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
