{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM"],
    // The vendored SSR node (src/ssr/NewSSRNode.js) is a straight copy of the three.js fork's JS source;
